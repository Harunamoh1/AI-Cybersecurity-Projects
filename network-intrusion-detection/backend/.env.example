# Copy to .env (never commit .env). All variables are optional.
SENTINEL_MODEL_DIR=./models
SENTINEL_SAMPLES_DIR=./samples
SENTINEL_DB_PATH=./sentinel.db
SENTINEL_CORS_ORIGINS=http://localhost:3000
# Shared secret required on every /api/v1 route when set (the Next.js proxy sends it).
SENTINEL_API_KEY=
SENTINEL_MAX_UPLOAD_MB=25
SENTINEL_MAX_ROWS=100000
SENTINEL_MAX_BATCH=1000
SENTINEL_MAX_EXPLAIN=25
SENTINEL_RETENTION_ANALYSES=200
SENTINEL_RATE_LIMIT=60
SENTINEL_THREADS=2
SENTINEL_VERIFY_CHECKSUM=true
